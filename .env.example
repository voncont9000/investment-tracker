TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=data/tracker.db
POLL_INTERVAL_MINUTES=15

# Needed for the "Analyse COMPANY" command and the weekly sell-thesis
# sweep (with EXA_API_KEY below). Leave unset and every other command
# still works — only Analyse and the thesis sweep are disabled.
ANTHROPIC_API_KEY=

# Sell-alert P&L rules (percent, as a decimal) — how far above cost to
# suggest taking profit, how far below cost to cut losses, and how far
# off the peak price since purchase to trail a stop. Defaults shown.
TAKE_PROFIT_PCT=0.30
STOP_LOSS_PCT=0.20
TRAILING_STOP_PCT=0.15

# Needed for the weekly sell-thesis sweep (news retrieval). Leave unset
# and the sweep doesn't run — everything else, including the other sell
# alerts, still works. Get a key at https://dashboard.exa.ai
EXA_API_KEY=
