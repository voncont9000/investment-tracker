TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=data/tracker.db
POLL_INTERVAL_MINUTES=15
WATCHLIST_DROP_THRESHOLD=-0.10
HOLDING_GAIN_THRESHOLD=0.10
TRAILING_WINDOW_HOURS=12

# Needed for the "Analyse COMPANY" command *and* the daily politician-trades
# digest's full report step. Leave unset and every other command still
# works — only Analyse (and running a full report from the digest) reply
# with a setup message.
ANTHROPIC_API_KEY=

# --- Daily politician-trades digest ---
TIMEZONE=Europe/London
DAILY_DIGEST_TIME=07:00

# Optional. The free House Clerk source works with no key. Senate trades
# have no free source (their own site blocks automated access) — this stays
# unset until you wire up a paid provider (see app/politician_trades/sources/senate.py).
# SENATE_SOURCE_PROVIDER=
